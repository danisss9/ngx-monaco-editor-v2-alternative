{
  "name": "ngx-monaco-editor-v2-alternative",
  "version": "22.1.0",
  "description": "Monaco Code Editor For Angular",
  "keywords": [
    "angular",
    "monaco",
    "monaco-editor-v2",
    "code",
    "editor",
    "reusable"
  ],
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "run-s build-editor serve",
    "serve": "ng serve",
    "build": "ng build --project=editor-tester --base-href=editor-tester --configuration=development",
    "build:prod": "ng build --project=editor-tester --base-href=editor-tester",
    "lint": "ng lint",
    "build-and-deploy-demo": "npm run build:prod && copy dist\\editor-tester\\browser\\index.html dist\\editor-tester\\browser\\200.html && cd dist\\editor-tester\\browser && surge --domain ngx-monaco-editor-v2.surge.sh",
    "build-editor": "npm run copy:readme && ng build editor",
    "npm-publish": "npm run build-editor && npm-publish.bat",
    "copy:readme": "copy README.md projects\\editor\\"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/danisss9/ngx-monaco-editor-v2-alternative.git"
  },
  "bugs": {
    "url": "https://github.com/danisss9/ngx-monaco-editor-v2-alternative/issues"
  },
  "author": "Miroslav Maksimovic",
  "contributors": [
    "Atul Kumar <atulaggarwal4288@gmail.com>",
    "Miroslav Maksimovic <miroslavmaksimovic95@gmail.com>",
    "Thomas-Louis Simard <thomas.louis.simard@gmail.com>"
  ],
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "monaco-editor": "^0.56.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.7.0",
    "ng-packagr": "^22.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
